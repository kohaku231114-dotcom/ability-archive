name: Extract ABILITY ARCHIVE

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  extract:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Extract ZIP
        run: |
          set -e
          ZIP=$(find . -maxdepth 1 -type f -name 'ability-archive*.zip' | sort | tail -n 1)
          test -n "$ZIP"
          unzip -o "$ZIP" -d extracted
          ROOT=$(find extracted -type f -name index.html -printf '%h\n' | head -n 1)
          test -n "$ROOT"
          rsync -a --exclude='.git' --exclude='.github' --exclude='.env*' --exclude='*.pem' "$ROOT/" ./
          rm -rf extracted

      - name: Save files
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add .
          git diff --cached --quiet || git commit -m "Extract ABILITY ARCHIVE"
          git push
